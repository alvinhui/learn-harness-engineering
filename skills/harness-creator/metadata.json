{
  "name": "harness-creator",
  "version": "1.0.0",
  "description": "Harness engineering for AI coding agents — five core subsystems plus retrofit of legacy repos into a full .ai/ knowledge base and multi-tool adapters.",
  "license": "MIT",
  "author": "Learn Harness Engineering",
  "repository": "https://github.com/walkinglabs/learn-harness-engineering",
  "languages": [
    "en",
    "zh"
  ],
  "compatibility": {
    "minCliVersion": "0.1.0",
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/skill-runtime-pattern.md",
    "references/tool-registry-pattern.md",
    "references/multi-agent-pattern.md",
    "references/lifecycle-bootstrap-pattern.md",
    "references/gotchas.md"
  ],
  "triggers": [
    "harness engineering",
    "agent reliability",
    "session continuity",
    "memory persistence",
    "verification workflow",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "CLAUDE.md",
    "feature tracking",
    "session handoff",
    "multi-agent coordination",
    "context engineering",
    "tool safety",
    "permission pipeline",
    "retrofit harness",
    "upgrade harness",
    "legacy repo harness",
    "AI-ready repository",
    ".ai directory"
  ],
  "bundled": {
    "scripts": [
      "scripts/create-harness.mjs",
      "scripts/validate-harness.mjs",
      "scripts/render-assessment-html.mjs",
      "scripts/run-benchmark.mjs",
      "scripts/lib/harness-utils.mjs",
      "scripts/analyze-repo.mjs",
      "scripts/retrofit-harness.mjs"
    ],
    "assets": [],
    "templates": [
      "templates/agents.md",
      "templates/feature-list.json",
      "templates/feature-list.schema.json",
      "templates/init.sh",
      "templates/progress.md",
      "templates/session-handoff.md",
      "templates/retrofit/agents-rich.md",
      "templates/retrofit/architecture.md",
      "templates/retrofit/implementation-notes.md",
      "templates/retrofit/deployment.md",
      "templates/retrofit/project-origin.md",
      "templates/retrofit/adr-template.md",
      "templates/retrofit/cursor-harness.mdc",
      "templates/retrofit/claude-settings.json",
      "templates/retrofit/init-multimode.sh",
      "templates/retrofit/ai-readme.md",
      "templates/retrofit/feature-list-real.json"
    ]
  }
}
